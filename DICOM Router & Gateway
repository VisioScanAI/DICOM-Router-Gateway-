--- pkg/buffer/buffer.go ---
```go
package buffer

import (
    "encoding/json"
    "fmt"
    "io/ioutil"
    "os"
    "path/filepath"
    "sync"
    "time"
)

type Event struct {
    StudyInstanceUID string                 `json:"studyInstanceUID"`
    Timestamp        int64                  `json:"timestamp"`
    Data             map[string]interface{} `json:"data"`
}

var (
    bufferDir = "buffer"
    mu        sync.Mutex
)

func init() {
    os.MkdirAll(bufferDir, os.ModePerm)
}

func Enqueue(evt Event) error {
    mu.Lock()
    defer mu.Unlock()
    fname := filepath.Join(bufferDir, fmt.Sprintf("%s_%d.json", evt.StudyInstanceUID, evt.Timestamp))
    b, err := json.Marshal(evt)
    if err != nil {
        return err
    }
    return ioutil.WriteFile(fname, b, 0644)
}

func Dequeue() (*Event, error) {
    mu.Lock()
    defer mu.Unlock()
    files, err := ioutil.ReadDir(bufferDir)
    if err != nil {
        return nil, err
    }
    if len(files) == 0 {
        return nil, nil
    }
    f := files[0]
    path := filepath.Join(bufferDir, f.Name())
    data, err := ioutil.ReadFile(path)
    if err != nil {
        return nil, err
    }
    var evt Event
    if err := json.Unmarshal(data, &evt); err != nil {
        return nil, err
    }
    os.Remove(path)
    return &evt, nil
}
