--- pkg/dispatcher/dispatcher.go ---
```go
package dispatcher

import (
    "bytes"
    "encoding/json"
    "fmt"
    "net/http"
)

const GPUURL = "http://gpu-engine:8000/process"

func Dispatch(evt interface{}) error {
    b, err := json.Marshal(evt)
    if err != nil {
        return err
    }
    resp, err := http.Post(GPUURL, "application/json", bytes.NewReader(b))
    if err != nil {
        return err
    }
    defer resp.Body.Close()
    if resp.StatusCode >= 400 {
        return fmt.Errorf("GPU engine error: %v", resp.Status)
    }
    return nil
}
