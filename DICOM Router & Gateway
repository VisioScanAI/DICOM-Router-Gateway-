```cpp
#include "OrthancPlugin.h"
#include <curl/curl.h>
#include <json/json.h>
#include <ctime>

static std::string OnStoredInstance(
    const OrthancPlugin* plugin,
    const char* /*event*/, 
    const char* instance,
    const OrthancPluginDicomTags* /*tags*/)
{
    Json::Value root;
    root["StudyInstanceUID"] = OrthancPluginGetStudyInstanceUID(plugin, instance);
    root["Timestamp"] = (Json::Int64)std::time(nullptr);
    Json::StreamWriterBuilder writer;
    std::string body = Json::writeString(writer, root);

    CURL* curl = curl_easy_init();
    if (curl) {
        curl_easy_setopt(curl, CURLOPT_URL, "http://localhost:8080/hooks/study");
        curl_easy_setopt(curl, CURLOPT_POSTFIELDS, body.c_str());
        curl_easy_perform(curl);
        curl_easy_cleanup(curl);
    }
    return std::string();
}

ORTHANC_PLUGINS_API void OrthancPluginInitialize(OrthancPlugin* plugin)
{
    plugin->SetName("VisioScanRouter");
    plugin->SetDescription("Forwards new studies to VISIOSCAN router");
    plugin->SetVersion("0.1.0");
    plugin->SetRequiredOrthancVersion("1.7.0");
    plugin->SetOnStoredInstanceCallback(OnStoredInstance);
}
